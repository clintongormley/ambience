{
  "name": "ambience-panel",
  "version": "0.1.0",
  "description": "Frontend panel for the Ambience HA integration",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/check-deps.mjs",
    "build": "node esbuild.config.mjs",
