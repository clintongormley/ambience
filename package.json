    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "lit": "^3.2.0"
  }
}
