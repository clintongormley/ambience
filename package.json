{
  "name": "ambience-panel",
  "version": "0.22.0",
  "description": "Frontend panel for the Ambience HA integration",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node bin/check-deps.mjs",
    "build": "node esbuild.config.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome lint frontend/src test",
    "lint:fix": "biome lint --write frontend/src test",
    "format": "biome format --write frontend/src test",
    "format:check": "biome format frontend/src test",
    "ci": "biome ci frontend/src test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "lit": "^3.2.0"
  }
}
