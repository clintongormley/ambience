// markdownlint config — advisory, for the editor (markdownlint VS Code extension).
// It is NOT run in CI; it just stops the editor from flagging the docs' deliberate
// house style and the shape of the *generated* AI guide. Genuine nits (e.g. list
// spacing, MD032) stay ON and are fixed in source — only the stylistic/structural
// rules below are turned off, each for a concrete reason.
{
  "default": true,

  // Prose is hand-wrapped at ~80, but reference tables, fenced code, and URLs
  // intentionally run long.
  "MD013": false, // line-length

  // The reference docs use compact pipe tables (|---|---|) throughout.
  "MD060": false, // table-column-style

  // Bold lead-ins (**Shape.**, **Intent → predicate**) are a deliberate label
  // style, not section headings.
  "MD036": false, // no-emphasis-as-heading

  // Asterisk vs underscore emphasis is mixed across the hand-authored docs and is
  // not worth normalising.
  "MD049": false, // emphasis-style

  // docs/.../ambience-ai-guide.md is generated by concatenating standalone section
  // files, each a self-contained doc — so it legitimately has several H1s and
  // repeats section names (Daytime / Nighttime / Examples).
  "MD025": false, // single-title (one top-level heading)
  "MD024": false, // no-duplicate-heading

  // <placeholder> tokens (e.g. <the group's category>) and the generated reference
  // tables read as inline HTML.
  "MD033": false, // no-inline-html

  // A few intentionally language-less fences (incl. the generated /plugin block).
  "MD040": false // fenced-code-language
}
