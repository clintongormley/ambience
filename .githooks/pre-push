#!/bin/sh
# Local pre-push gate. Strategy: fast lint/format first (the usual CI culprit),
# then run ONLY the changed language's tests + always-cheap drift checks, so
# pushing stays lightweight but CI rarely fails.
#
# Install once per clone:  sh bin/install-hooks.sh
# Bypass in an emergency:  git push --no-verify
set -eu

ZERO=0000000000000000000000000000000000000000

# Pick a base ref to diff "what we're pushing" against, most-specific first.
default_base() {
  for ref in origin/main main origin/HEAD; do
    if git rev-parse --verify --quiet "$ref" >/dev/null 2>&1; then
      echo "$ref"
      return 0
    fi
  done
  echo "HEAD~1"  # last resort: just the tip commit
}

# Changed files for a range; falls back to `HEAD~1..HEAD` (committed changes
# only — a bare working-tree diff would gate uncommitted files that aren't
# being pushed at all).
diff_names() {
  git diff --name-only "$1" 2>/dev/null || git diff --name-only HEAD~1..HEAD
}

# Append "<branch-point> <tip>" to cl_checks for the changelog gate. Branch point
# = merge-base with main (mirrors CI's base=main / head=branch-tip), NOT
# remote_sha — so an entry added in an earlier push still counts and a no-op
# re-push isn't falsely blocked.
add_cl_check() {
  cl_base="$(git merge-base "$(default_base)" "$1" 2>/dev/null || true)"
  # if/fi (not `[ … ] && …`): as the function's last command a failed test would
  # propagate non-zero and, under set -e, abort the hook on an empty merge-base
  # (orphan/unrelated history). Fail open instead — CI is the authoritative gate.
  if [ -n "$cl_base" ]; then
    cl_checks="${cl_checks}${cl_base} $1
"
  fi
}

# Read the ref updates git feeds us on stdin and accumulate the changed files
# across EVERY pushed ref (a `git push origin a b` must gate both, not just
# the last one read).
changed=""
ranges=""
cl_checks=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion: nothing to test
  if [ "$remote_sha" = "$ZERO" ]; then            # new branch on the remote
    base="$(git merge-base "$(default_base)" "$local_sha" 2>/dev/null || default_base)"
    range="${base}..${local_sha}"
  else
    range="${remote_sha}..${local_sha}"
  fi
  ranges="${ranges}${ranges:+ }${range}"
  changed="${changed}
$(diff_names "$range")"
  add_cl_check "$local_sha"
done

# Fallback when stdin gave us nothing (e.g. a manual invocation).
if [ -z "$ranges" ]; then
  ranges="$(default_base)...HEAD"
  changed="$(diff_names "$ranges")"
  add_cl_check HEAD
fi

echo "pre-push: inspecting $(printf '%s\n' "$changed" | grep -c . || true) changed file(s) in range(s) $ranges"

py_changed=$(printf '%s\n' "$changed" | grep -E '\.py$' || true)
# The standalone mcp-server package has its own test suite + deps, separate from
# the HA backend. Split them so each gates only its own tests (ruff still sweeps
# both via lint-py's `ruff check .`).
backend_py_changed=$(printf '%s\n' "$changed" | grep -E '\.py$' | grep -vE '^mcp-server/' || true)
mcp_changed=$(printf '%s\n' "$changed" | grep -E '^mcp-server/.*\.py$|^mcp-server/pyproject\.toml$' || true)
js_changed=$(printf '%s\n' "$changed" | grep -E '^(frontend/src|test)/.*\.ts$' || true)
bundle_src_changed=$(printf '%s\n' "$changed" | grep -E '^frontend/src/' || true)
trans_changed=$(printf '%s\n' "$changed" | grep -E 'strings\.json$|/translations/' || true)
# The AI knowledge pack's generated sections derive from the conditions, the
# built-in services and the curated source docs — regen + diff when any change.
ai_docs_src_changed=$(printf '%s\n' "$changed" | grep -E '^custom_components/ambience/conditions/|^custom_components/ambience/services\.yaml$|^custom_components/ambience/manifest\.json$|^docs/developers/ai-authoring/|^ai/skill/|^bin/gen_ai_docs\.py$' || true)
# Hand-written Markdown only — the AI knowledge pack and generated AI-authoring
# docs are owned by gen_ai_docs.py / the ai-docs gate, so mdformat skips them
# (.mdformat.toml exclude) and a change there must not trigger this gate.
md_changed=$(printf '%s\n' "$changed" | grep -E '\.md$|\.markdown$' | grep -vE '^(ai/|docs/developers/ai-authoring/)' || true)

# --- Step 1: fast lint/format (fail fast — this is usually what breaks CI) ---
if [ -n "$py_changed" ]; then echo "› ruff";       make lint-py; fi
if [ -n "$js_changed" ]; then echo "› biome+tsc";   make lint-js; fi
if [ -n "$md_changed" ]; then echo "› mdformat";    make lint-md; fi

# --- Step 2: always-cheap i18n gates (parity, completeness, no-hardcoded) ---
if [ -n "$backend_py_changed$trans_changed$bundle_src_changed" ]; then echo "› i18n"; make i18n; fi

# --- Step 3: changed-language tests + coverage ---
if [ -n "$backend_py_changed" ];  then echo "› backend tests+coverage";  make coverage-py; fi
if [ -n "$mcp_changed" ];         then echo "› mcp-server tests";         make mcp-tests; fi
if [ -n "$js_changed" ];          then echo "› frontend tests+coverage"; make coverage-js; fi
if [ -n "$bundle_src_changed" ];  then echo "› bundle freshness";        make build-check; fi
if [ -n "$ai_docs_src_changed" ]; then echo "› ai-docs freshness";       make ai-docs-check; fi

# --- Step 4: changelog entry for user-facing branches (stdlib-only, cheap) ---
# Mirrors CI's changelog job. File-agnostic: required-ness comes from the
# branch's commit types (feat/fix/perf), not which files changed.
if [ -n "$cl_checks" ]; then
  echo "› changelog"
  printf '%s' "$cl_checks" | while read -r cl_base cl_head; do
    [ -n "$cl_head" ] || continue
    python3 -m bin.changelog check-range --base "$cl_base" --head "$cl_head" || exit 1
  done
fi

echo "pre-push: all gates passed ✓"
